PORT=3000
NODE_ENV=development
# Generate a private random value: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_YOUR_RANDOM_SECRET"
DATABASE_URL="mysql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@localhost:3306/shoppia"

# TiDB Cloud: copy the Prisma URL, replace the password, and keep strict TLS enabled.
# DATABASE_URL="mysql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_TIDB_HOST:4000/test?sslaccept=strict"
